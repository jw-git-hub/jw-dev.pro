# Копия этого файла лежит на сервере как .env и в репозиторий не попадает.
# Ни одно значение отсюда не должно оказаться в коде сайта: репозиторий публичный.

# Куда падают заявки с формы. Токен — у @BotFather, chat id — у @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Дубль заявки на почту — необязателен. Пока SMTP_HOST пуст, заявка идёт
# только в Telegram, и это рабочий режим, а не поломка.
#
# MAIL_TO с 04.09.2026 не заполняют: пустая строка означает корпоративную
# info@jw-dev.pro, зашитую в config.py. Личный ящик владельца выведен из работы
# сайта совсем — если он остался в .env на сервере, строку надо стереть,
# иначе окружение перебьёт умолчание и заявки продолжат уходить туда.
# Секретами остаются только пароль SMTP и токен бота.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_TO=

# Защита от спама: сколько заявок с одного адреса за час.
RATE_LIMIT_PER_HOUR=5
