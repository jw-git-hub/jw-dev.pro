---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LogArchive from '../../../components/log/LogArchive.astro';
import { useTranslations } from '../../../i18n';
import { ogPath } from '../../../lib/og';
import { pageGraph } from '../../../lib/jsonld';
import { logPath } from '../../../lib/journal';

const t = useTranslations('ru');
---

<BaseLayout
  title={t('log.title')}
  description={t('log.lead')}
  accent="violet"
  image={ogPath('ru', 'log')}
  schema={pageGraph(t('log.title'), logPath('ru'), 'ru', Astro.site)}
>
  <LogArchive />
</BaseLayout>
