---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkArchive from '../../components/work/WorkArchive.astro';
import { useTranslations } from '../../i18n';
import { ogPath } from '../../lib/og';
import { pageGraph } from '../../lib/jsonld';
import { workPath } from '../../lib/cases';

const t = useTranslations('en');
---

<BaseLayout
  title={t('work.title')}
  description={t('work.lead')}
  accent="rose"
  image={ogPath('en', 'work')}
  schema={pageGraph(t('work.title'), workPath('en'), 'en', Astro.site)}
>
  <WorkArchive />
</BaseLayout>
