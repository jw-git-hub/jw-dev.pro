---
import { localeFromUrl, useTranslations, localizePath, LOCALES } from '../i18n';
import Backdrop from '../components/chrome/Backdrop.astro';
import Header from '../components/chrome/Header.astro';
import Footer from '../components/chrome/Footer.astro';
import Dock from '../components/chrome/Dock.astro';
import { SITE } from '../data/site';
import type { Accent } from '../data/accent';
import '../styles/main.css';

interface Props {
  /** Заголовок страницы без имени сайта — оно добавляется здесь. */
  title?: string;
  description?: string;
  /** Страницы вроде 404 не должны попадать в индекс. */
  noindex?: boolean;
  /** Куда ведёт переключатель языка, если «эта же страница» на другом языке не существует. */
  langPath?: string;
  /** Картинка превью, путь от корня. Без неё мессенджер покажет ссылку одной строкой. */
  image?: string;
  /** Тип страницы для OG: разбор кейса — это статья, а не сайт целиком. */
  ogType?: 'website' | 'article';
  /**
   * Акцент страницы до первой прокрутки. На главной его дальше ведёт accent.js
   * по секциям, на внутренних он остаётся один. Задан в разметке, а не в скрипте,
   * чтобы страница открывалась в своём цвете и без JS.
   */
  accent?: Accent;
}

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);

const {
  title,
  description = t('site.description'),
  noindex = false,
  langPath,
  image,
  ogType = 'website',
  accent = 'cyan',
} = Astro.props;

// Главная называется собой целиком, внутренние — «Раздел — jw-dev.pro».
const pageTitle = title ? `${title} — ${SITE.name}` : t('site.title');

const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * hreflang для обоих языков плюс x-default на английский.
 * Без этого поиск считает RU- и EN-версии дублями и выбирает одну сам.
 */
const alternates = LOCALES.map((code) => ({
  code,
  href: new URL(localizePath(Astro.url.pathname, code), Astro.site).href,
}));
const defaultHref = alternates.find((a) => a.code === 'en')!.href;
---

<html lang={locale} data-acc={accent}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#070912" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}

    {
      /* У страницы ошибки нет канонического адреса и языковых пар:
         она не страница, а ответ сервера на несуществующий адрес. */
      !noindex && (
        <>
          <link rel="canonical" href={canonical.href} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.code} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={defaultHref} />
        </>
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      /* Предзагружаем подмножество своего языка: на нём набран весь текст страницы,
        и без этого шрифт находится только после разбора CSS. Второе подмножество
        (знак, «GitHub», переключатель языка) доедет само.

        crossorigin обязателен даже со своего домена: шрифты качаются в режиме CORS,
        и без атрибута preload не засчитывается — файл скачается дважды. */
    }
    <link
      rel="preload"
      href={locale === 'ru' ? '/fonts/onest-cyrillic.woff2' : '/fonts/onest-latin.woff2'}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />

    {
      /* Абсолютный адрес обязателен: относительный путь Telegram и Slack
        не разворачивают и картинку просто не покажут. */
      image && (
        <>
          <meta property="og:image" content={new URL(image, Astro.site).href} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
  </head>

  <body>
    <a class="skip" href="#main">{t('a11y.skip')}</a>

    <Backdrop />

    <Header langPath={langPath} />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <Dock />

    <script>
      import '../scripts/header.js';
      import '../scripts/nav.js';
      import '../scripts/dock.js';
      import '../scripts/reveal.js';
      import '../scripts/graph.js';
      import '../scripts/pointer.js';
      import '../scripts/parallax.js';
      import '../scripts/counters.js';
      import '../scripts/filters.js';
      import '../scripts/overlay.js';
      import '../scripts/accent.js';
    </script>
  </body>
</html>
