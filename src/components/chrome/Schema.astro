---
/**
 * Блок данных schema.org в `<head>`.
 *
 * Это единственное исключение из правила «ноль инлайна»: браузер такой блок
 * не исполняет, CSP его не блокирует, а внешним файлом его читают не все
 * поисковики. Исключение зашито в `tests/check-inline.mjs` по типу тега.
 *
 * Граф отдаётся одним узлом `@graph`, а не пятью тегами подряд: так ссылки
 * по `@id` между человеком, сайтом и статьёй разрешаются внутри одного блока.
 */
interface Props {
  nodes: Record<string, unknown>[];
}

const { nodes } = Astro.props;

/*
 * `<` экранируется в `<`: последовательность `</script>` внутри строки
 * закрыла бы блок раньше времени, и остаток графа вывалился бы в разметку
 * как текст. Для JSON это тот же символ — значение не меняется.
 */
const graph = JSON.stringify({ '@context': 'https://schema.org', '@graph': nodes }).replace(
  /</g,
  '\\u003c',
);
---

<script type="application/ld+json" is:inline set:html={graph} />
