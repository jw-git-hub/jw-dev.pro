---
/**
 * Заголовок внутренней страницы: ровно один h1 и подзаголовок. Содержимое
 * приходит слотом — у политики это текст, у страниц ответа формы кнопка,
 * а у страницы ошибки ссылка на главную.
 */
interface Props {
  title: string;
  lead?: string;
}

const { title, lead } = Astro.props;
---

<section class="page-head">
  <div class="wrap">
    <div class="sec-head rv" data-damp>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
    <slot />
  </div>
</section>
