---
/**
 * Заголовок внутренней страницы: ровно один h1, подзаголовок и — пока раздел
 * пуст — честная строка о том, чего здесь ждать. Пустой раздел, который молчит,
 * читается как поломка.
 *
 * Строка про пустоту набрана `.lead`, а не `.mono`: `.mono` — это подпись
 * («SCREENSHOT», «STATUS», «/log»), и гайд §18 разрешает ей цвет --ink3
 * только на 10–12px. Капитель кириллицы моноширинным с трекингом 0.14em —
 * самое медленное для чтения сочетание в системе, а здесь это единственное
 * содержательное предложение на странице.
 */
interface Props {
  title: string;
  lead?: string;
  note?: string;
}

const { title, lead, note } = Astro.props;
---

<section class="page-head">
  <div class="wrap">
    <div class="sec-head rv" data-damp>
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      {note && <p class="page-note lead">{note}</p>}
    </div>
    <slot />
  </div>
</section>
