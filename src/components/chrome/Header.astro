---
/**
 * Шапка. Фиксированная, стеклянная, при прокрутке ужимается до 52px
 * (класс `stuck` вешает header.js).
 *
 * Бургер — <summary> настоящего <details>, а не кнопка с обработчиком:
 * меню обязано открываться без JS. Шторка начинается под шапкой, чтобы
 * бургер оставался виден и закрывал меню повторным нажатием.
 */
import { NAV_ITEMS } from '../../data/nav';
import { SITE } from '../../data/site';
import { localeFromUrl, useTranslations, homePath, sectionPath } from '../../i18n';
import Icon from './Icon.astro';
import Mark from './Mark.astro';
import LangSwitch from './LangSwitch.astro';
import MobileNav from './MobileNav.astro';

interface Props {
  /** Куда ведёт переключатель языка. По умолчанию — та же страница. */
  langPath?: string;
}

const { langPath } = Astro.props;

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);

/**
 * Словесный знак режется из домена по последней точке: имя набирается
 * основным цветом, зона приглушается. Литерала здесь нет намеренно —
 * имя сайта живёт в SITE.name, и шапка обязана совпадать с адресной
 * строкой, иначе посетитель видит два разных названия.
 */
const dot = SITE.name.lastIndexOf('.');
const brandName = SITE.name.slice(0, dot);
const brandZone = SITE.name.slice(dot);
---

<header class="hdr" id="hdr">
  <div class="wrap hdr-in">
    {
      /* aria-label не нужен: доступным именем ссылки стал сам словесный знак.
        Подпись, расходящаяся с видимым текстом, ломает голосовое управление —
        человек говорит «jw-dev.pro», а команда ищет «На главную». */
    }
    <a class="brand" href={homePath(locale)}>
      <Mark />
      {
        /* Строго одной строкой: Astro, в отличие от JSX, сохраняет перенос
          как пробел, и знак распадётся на «jw-dev .pro». */
      }
      <span class="wordmark">{brandName}<span class="zone">{brandZone}</span></span>
    </a>

    <nav class="nav" aria-label={t('a11y.nav')}>
      {NAV_ITEMS.map((item) => <a href={item.href(locale)}>{t(item.key)}</a>)}
    </nav>

    <div class="hdr-r">
      <LangSwitch path={langPath} />
      <a class="btn hdr-cta" href={sectionPath(locale, 'contact')}>
        {t('cta.header')}
        <Icon name="arr" size={14} />
      </a>

      <details class="mnav-holder" id="menu">
        <summary class="burger" aria-label={t('a11y.menu')}>
          <i></i><i></i><i></i>
        </summary>
        <MobileNav />
      </details>
    </div>
  </div>
</header>
