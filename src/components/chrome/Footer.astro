---
/**
 * Подвал. Контактов здесь ровно столько, сколько существует: GitHub и Telegram.
 * Почты нет — временный адрес владельца на сайте не показывается, а корпоративная
 * появится вместе с доменом (см. src/data/site.ts).
 */
import { SITE, BUILD_YEAR } from '../../data/site';
import { HAS_ANALYTICS } from '../../data/analytics';
import { localeFromUrl, useTranslations, localizePath } from '../../i18n';
import Icon from './Icon.astro';
import Mark from './Mark.astro';

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
---

<footer>
  <div class="wrap foot">
    <div class="foot-l">
      <Mark class="mark-sm" />
      <span>© {BUILD_YEAR} {SITE.name}</span>
    </div>

    <span>{t('footer.note')}</span>

    <div class="foot-l">
      <a href={localizePath('/privacy/', locale)}>{t('footer.privacy')}</a>
      {
        /* Отозвать согласие должно быть так же легко, как дать: ссылка открывает
           баннер заново. Без JS она ведёт в раздел политики про куки — там
           написано то же самое словами, а счётчика без JS всё равно нет. */
        HAS_ANALYTICS && (
          <a href={`${localizePath('/privacy/', locale)}#cookies`} data-consent>
            {t('footer.cookies')}
          </a>
        )
      }
      <a href={SITE.telegram} target="_blank" rel="noopener" aria-label={t('footer.telegram')}>
        <Icon name="tg" size={17} />
      </a>
      <a href={SITE.github} target="_blank" rel="noopener" aria-label={t('footer.github')}>
        <Icon name="gh" size={17} />
      </a>
    </div>
  </div>
</footer>
