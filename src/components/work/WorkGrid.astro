---
/**
 * Секция кейсов на главной — DESIGN-GUIDE §8.
 *
 * Порядок карточек задаёт поле `order` кейса, а не дата: сетка — витрина,
 * её очерёдность решает владелец. Хронология живёт в журнале.
 */
import CaseCard from './CaseCard.astro';
import CaseFilters from './CaseFilters.astro';
import CaseOverlay from './CaseOverlay.astro';
import Icon from '../chrome/Icon.astro';
import { getCases } from '../../lib/cases';
import { localeFromUrl, useTranslations } from '../../i18n';

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const cases = await getCases(locale);

// Кейсов может не быть вовсе: их переписывают с нуля. Пустая сетка с фильтром
// «0 / 0» выглядит как сломанная вёрстка, а не как «здесь пока пусто».
const hasCases = cases.length > 0;
---

<section id="work" data-acc="rose" data-name={t('nav.work')} data-dock="case">
  <div class="wrap">
    <div class="sec-head row rv">
      <div>
        <span class="kick">{t('kick.work')}</span>
        <h2>{t('sec.work.t')}</h2>
        {
          /* «Каждый проект ниже» — обещание про карточки. Без карточек оно
            указывает в пустоту, поэтому строка уходит вместе с ними. */
          hasCases && (
            <p class="workline">
              <Icon name="gh" size={16} />
              <span>{t('work.note')}</span>
            </p>
          )
        }
      </div>

      {hasCases && <CaseFilters total={cases.length} />}
    </div>

    {
      hasCases ? (
        <div class="grid6" data-grid>
          {cases.map((item) => (
            <CaseCard item={item} />
          ))}
        </div>
      ) : (
        <p class="sec-none lead">{t('work.empty')}</p>
      )
    }
  </div>

  <CaseOverlay />
</section>
