---
/**
 * Витрина кейсов на главной — DESIGN-GUIDE §8.
 *
 * Показывает первые карточки по полю `order`, а не последние по дате: дата
 * кейса равна дате последнего коммита проекта, и правка опечатки в старом боте
 * вытолкнула бы его вперёд сильной работы. Очерёдность витрины решает владелец,
 * хронология живёт в журнале.
 *
 * Здесь только начало. Все кейсы и фильтр по типу — на `/work/`: фильтровать
 * три карточки незачем, а сетка из семи съедает первый экран.
 */
import CaseGrid from './CaseGrid.astro';
import Icon from '../chrome/Icon.astro';
import { getCases, workPath } from '../../lib/cases';
import { localeFromUrl, useTranslations } from '../../i18n';

/** Витрина, а не архив: три карточки и ссылка на остальное. */
const PREVIEW_COUNT = 3;

const locale = localeFromUrl(Astro.url);
const t = useTranslations(locale);
const cases = await getCases(locale);
const shown = cases.slice(0, PREVIEW_COUNT);
---

<section id="work" data-acc="rose" data-name={t('nav.work')} data-dock="case">
  <div class="wrap">
    <div class="sec-head row rv">
      <div>
        <span class="kick">{t('kick.work')}</span>
        <h2>{t('sec.work.t')}</h2>
        {
          /* «Каждый проект ниже» — обещание про карточки. Без карточек оно
            указывает в пустоту, поэтому строка уходит вместе с ними. */
          shown.length > 0 && (
            <p class="workline">
              <Icon name="gh" size={16} />
              <span>{t('work.note')}</span>
            </p>
          )
        }
      </div>

      <a class="btn s" href={workPath(locale)}>
        <Icon name="arr" size={16} />
        <span>{t('work.all')}</span>
      </a>
    </div>

    <CaseGrid items={shown} level={3} />
  </div>
</section>
