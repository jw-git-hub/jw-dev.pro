---
/**
 * Содержимое слота скриншота: настоящий кадр, если он снят, иначе условная вёрстка.
 *
 * Развилка вынесена из карточки и страницы разбора, потому что она одна на двоих
 * и обязана решаться одинаково. Пока снимки есть не у всех кейсов, сетка живёт
 * смешанной, и это нормально: силуэт из пустых блоков не притворяется фотографией.
 *
 * Наборы ширин выведены из замера слота, а не из головы: карточка не бывает шире
 * 458 CSS-пикселей (узкое окно 1020px, две колонки), обложка — 1000.
 *
 * Потолок стоит ниже тройной плотности сознательно: над кадром лежат тинт
 * `mix-blend-mode: color` на 55% и вуаль в цвет карточки (§8), и третья ступень
 * платит десятки килобайт за деталь, которую они и так съедают.
 *
 * А вот вторую ступень трогать нельзя, и это замер, а не вкус. Слот карточки
 * снят попиксельно на экране двойной плотности (756×474) в четырёх сборках,
 * «заметно» здесь — расхождение больше 8/255:
 *
 *   - снять ступень 760w → мягчеют края букв: максимум 135/255, заметно
 *     у 5–8% пикселей. Экономия 10,4 КБ на кадр;
 *   - опустить качество с 80 до 60 при той же ступени → максимум 49/255,
 *     заметно у 1,0–1,2% пикселей. Экономия 5,0 КБ на кадр.
 *
 * За килобайт резкость стоит вчетверо дороже качества, поэтому байты берутся
 * качеством: главная 243,2 → 233,3 КБ при потолке 260. Ступени остаются.
 *
 * Обложка разбора качество не режет. У страницы кейса 63 КБ запаса, давления
 * бюджета нет, а обложку разглядывают — в отличие от карточки, которую
 * проходят взглядом под вуалью.
 */
import { Image } from 'astro:assets';
import SiteMock from './SiteMock.astro';
import ChatMock from './ChatMock.astro';
import type { CaseView } from '../../lib/cases';

interface Props {
  item: CaseView;
  role: 'card' | 'cover';
}

/**
 * Ширины и `sizes` под каждую роль — из замера раскладок (DESIGN-GUIDE §17).
 * `quality` без значения означает «как у сборщика», то есть 80: тот же файл побайтно.
 */
const SOURCES = {
  card: {
    widths: [380, 460, 760],
    quality: 60,
    sizes: '(max-width: 640px) 92vw, (max-width: 1100px) 46vw, 380px',
  },
  cover: {
    widths: [400, 660, 960, 1400],
    quality: undefined,
    sizes: '(max-width: 1100px) 92vw, 1000px',
  },
};

const { item, role } = Astro.props;

const shot = item.screenshots.find((screenshot) => screenshot.role === role);
const Mock = item.shotKind === 'telegram' ? ChatMock : SiteMock;

/** Обложка разбора — первый экран страницы: ждать её нельзя (CONTENT-CASES §3). */
const loading = role === 'cover' ? 'eager' : 'lazy';
---

{
  shot ? (
    <Image
      src={shot.src}
      alt={shot.alt}
      widths={SOURCES[role].widths}
      quality={SOURCES[role].quality}
      sizes={SOURCES[role].sizes}
      loading={loading}
    />
  ) : (
    <Mock />
  )
}
