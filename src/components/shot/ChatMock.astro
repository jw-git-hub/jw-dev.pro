---
/**
 * Условная вёрстка Telegram в слоте скриншота: шапка диалога, три
 * сообщения, кнопки клавиатуры и поле ввода. Тот же принцип, что
 * у `SiteMock` — силуэт интерфейса, а не подделка под снимок.
 */
---

<div class="shot-b">
  <div class="tg-hdr">
    <span class="tg-av"></span>
    <span><span class="tg-nm"></span><span class="tg-on"></span></span>
  </div>

  <div class="tg-msgs">
    <span class="bub"><i></i><i></i></span>
    <span class="bub out"><i></i><i></i></span>
    <span class="bub"><i></i><i></i></span>
  </div>

  <div class="tg-kb"><i></i><i></i></div>
  <div class="tg-in"><i></i><b></b></div>
</div>
