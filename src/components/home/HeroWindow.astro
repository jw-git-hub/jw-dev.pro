---
/**
 * Окно сцены героя — DESIGN-GUIDE §10. Стекло с блюром, своя строка
 * заголовка и собственный цикл дрейфа.
 *
 * Положение, ширина и глубина `--tz` заданы классом позиции в hero.css,
 * а не атрибутом: глубина — свойство картинки, и без JS она обязана
 * остаться на месте. В разметке остаётся только `data-amp` — размах
 * параллакса, который считает parallax.js.
 */
interface Props {
  /** Класс позиции: `wA` — браузер, `wB` — Telegram, `wC` — панель метрик. */
  place: 'wA' | 'wB' | 'wC';
  /** Класс дрейфа: у каждого окна свой период, иначе сцена дышит хором. */
  drift: 'drift1' | 'drift2' | 'drift3';
  /** Размах параллакса, §10. */
  amp: number;
  /** Строка заголовка окна. Панель метрик обходится без неё. */
  title?: string;
  /** Тело окна — панель с цифрами, а не рамка вокруг снимка. */
  panel?: boolean;
}

const { place, drift, amp, title, panel = false } = Astro.props;
---

<div class:list={['win', place]} data-amp={amp}>
  <div class:list={['win-drift', drift]}>
    <div class:list={['win-body', 'g', 'blur', panel && 'mpanel']}>
      {
        title && (
          <div class="win-ttl">
            <i />
            <i />
            <i />
            <span>{title}</span>
          </div>
        )
      }
      <slot />
    </div>
  </div>
</div>
